{
	"name": "n8n-nodes-vermarco",
	"version": "0.1.0",
	"description": "Vermarco Rails for n8n: ask Vermarco, browse and preview listings, start checkout, fetch purchases and use the agent inbox through the Vermarco MCP server.",
	"license": "MIT",
	"homepage": "https://vermarco.com",
	"keywords": [
		"n8n-community-node-package",
		"vermarco",
		"vermarco-rails",
		"mcp",
		"ai-agents",
		"marketplace"
	],
	"author": {
		"name": "Vertical Marketplace LLC",
		"email": "hello@vermarco.com",
		"url": "https://vermarco.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ilya7-eng/n8n-nodes-vermarco.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/VermarcoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Vermarco/Vermarco.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
